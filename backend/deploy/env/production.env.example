FASTAPI_ENV=production
DEBUG=False
HOST=0.0.0.0

SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

SECRET_KEY=your-production-jwt-secret-min-32-chars
JWT_SECRET=your-production-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256

ALLOWED_ORIGINS=https://example.com,https://app.example.com

MAP_STORAGE_BACKEND=supabase
SYNTRAK_DATABASE_URL=postgresql+psycopg://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_STATIC_API_URL=https://maps.googleapis.com/maps/api/staticmap
GOOGLE_MAPS_ELEVATION_API_URL=https://maps.googleapis.com/maps/api/elevation/json
GOOGLE_MAPS_JS_API_URL=https://maps.googleapis.com/maps/api/js
GOOGLE_MAPS_MAP_ID=your-map-id