# ============================================
# APPLICATION
# ============================================
APP_NAME=main-backend
APP_VERSION=1.0.0

# ============================================
# ENVIRONMENT (SHARED: all services must match)
# ============================================
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# SERVER
# ============================================
HOST=0.0.0.0
PORT=8080

# ============================================
# SECURITY (SHARED: all services must use same SECRET_KEY)
# ============================================
SECRET_KEY=2ec2f5c155004ff6a83f6edd8f309f4c6d3873a5ecff79babf711e90a43e96e1
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ============================================
# CORS (comma-separated origins)
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8081

# ============================================
# DATABASE (SHARED Postgres)
# ============================================
