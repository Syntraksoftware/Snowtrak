# Root gitignore
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
build/
frontend/build/
frontend/.dart_tool/
frontend/.idea/
frontend/ios/Pods/
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/flutter_export_environment.sh
backend/.venv/
backend/data/*.geojson
**/.env
!**/.env.example
backend/postgres.env
backend/deploy/env/staging.env
backend/deploy/env/production.env
*.p8
.cursor/

# graphify knowledge-graph output (graph.json exceeds the 5MB CI guard)
graphify-out/

# fastlane run report, regenerated on every build
frontend/ios/fastlane/report.xml

# editor settings
.vscode/

# design source files -- Snowtrak_DesignSystem.fig alone is over 100MB, and a
# git blob is permanent. The fig file is the design source of truth; keep it in
# shared storage, not in history. See docs/frontend_design_system.md.
pencil_assets/

# manual screenshots, ~10MB and regenerated whenever the UI moves
screenshots/

# golden-diff output, written on every failed golden test
frontend/test/failures/

# per-machine Claude Code settings; .claude/settings.json is the shared one
.claude/settings.local.json
