          }
        },
        "required": [
          "items",
          "meta"
        ],
        "title": "ListResponse",
        "type": "object"
      },
      "PaginationMeta": {
        "description": "Standardized pagination metadata for list responses.\n\nAttributes:\n    limit: Number of items returned per page (query parameter)\n    offset: Starting position in the result set (query parameter)\n    total: Total number of items available\n    next_cursor: Opaque cursor for cursor-based pagination (next page start)\n    has_next: Whether more items exist after current page",
        "properties": {
          "has_next": {
            "description": "More items available after this page",
            "title": "Has Next",
            "type": "boolean"
          },
          "limit": {
            "description": "Items per page",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cursor for next page",
            "title": "Next Cursor"
          },
          "offset": {
            "description": "Starting position",
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "description": "Total items available",
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "limit",
          "offset",
          "total",
          "has_next"
        ],
        "title": "PaginationMeta",
        "type": "object"
      },
