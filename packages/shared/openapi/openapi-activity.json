      "ListResponse": {
        "description": "Standardized paginated list response.\n\nAll list endpoints must return items in this envelope with pagination metadata.\n\nAttributes:\n    items: List of actual items\n    meta: ListMeta with pagination and request tracking",
        "properties": {
          "items": {
            "description": "List of items",
            "items": {},
            "title": "Items",
