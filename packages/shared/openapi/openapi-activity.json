  "info": {
    "description": "## Canonical API surface\n\nAll supported clients MUST use **`/api/v1/*`** paths documented here.",
    "title": "Activity Backend API",
    "version": "1.0.0",
    "x-canonical-prefix": "/api/v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/activities/": {
      "get": {
        "description": "List the activities this viewer is allowed to see.",
        "operationId": "list_activities_api_v1_activities__get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Activities",
        "tags": [
          "activities"
        ]
      },
      "post": {
        "description": "Create a new activity and return frontend response shape.",
        "operationId": "create_activity_api_v1_activities__post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FrontendActivityCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendActivityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
